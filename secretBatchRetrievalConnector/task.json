{
    "id": "8817626a-b56b-4484-8639-59e66c138ecb",
    "name": "secretBatchRetrievalConnector",
    "friendlyName": "Conjur Secret Retrieval Connector",
    "description": "Retrieve secrets from Cyberark Conjur Secrets Manager using Service Connector",
    "author": "CyberArk",
    "category": "Build",
    "visibility": [
      "Build",
      "Release"
    ],
    "icons": {
      "default": "images/icon.png"
    },
    "demands": [],
    "version": {
      "Major": "1",
      "Minor": "3",
      "Patch": "0"
    },
    "minimumAgentVersion": "1.95.0",
    "instanceNameFormat": "Retrieve Conjur service Task $(project)",
    "inputs": [
      {
        "name": "authntype",
        "type": "picklist",
        "label": "Authenticate Type",
        "defaultValue": "api",
        "required": true,
        "helpMarkDown": "",
        "options": {
            "api": "api",
            "jwt": "jwt"
        },
        "properties": {
            "EditableOptions": "False"
        }
      },
      {
        "name": "ConjurService",
        "type": "connectedService:ConjurSC",
        "label": "Conjur service/server end point",
        "defaultValue": "",
        "required": true,
        "visibleRule": "authntype = api",
        "helpMarkDown": "Select the Conjur end point to use."
      },
      {
        "name": "ConjurJWTService",
        "type": "connectedService:ConjurJwtSC",
        "label": "Conjur service/server end point",
        "defaultValue": "",
        "required": true,
        "visibleRule": "authntype = jwt",
        "helpMarkDown": "Select the Conjur end point to use."
      },
      {
        "name": "secretsyml",
        "type": "string",
        "label": "Conjur secrets.yml File",
        "defaultValue": "./secrets.yml",
        "required": true,
        "helpMarkDown": "Conjur secrets.yml File"
      },
      {
        "name": "serviceNameAzureRM",
        "type": "connectedService:AzureRM",
        "label": "Azure Service Connection",
        "required": true,
        "visibleRule": "authntype = jwt",
        "helpMarkDown": "Select an Azure Resource Manager Service Connection"
      }
    ],
    "execution": {
      "Node10": {
        "target": "index.js",
        "argumentFormat": ""
      },
      "Node16": {
          "target": "index.js",
          "argumentFormat": ""
      },
      "Node20_1": {
          "target": "index.js",
          "argumentFormat": ""
      }
    }
}